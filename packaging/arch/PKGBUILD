# Maintainer: UberMetroid <ubermetroid@users.noreply.github.com>
pkgname=dockd
pkgver=0.1.3
pkgrel=1
pkgdesc="Pure-standard-library Rust application dock and window manager daemon for Omarchy & Hyprland"
arch=('x86_64' 'aarch64')
url="https://github.com/UberMetroid/dockd"
license=('GPL-2.0-or-later')
depends=('systemd' 'glibc')
optdepends=(
    'omarchy: Omarchy desktop environment'
    'quickshell: Quickshell Wayland desktop shell'
)
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver" 2>/dev/null || cd "$srcdir/$pkgname" 2>/dev/null || true
    cargo build --release
}

check() {
    cd "$pkgname-$pkgver" 2>/dev/null || cd "$srcdir/$pkgname" 2>/dev/null || true
    cargo test
}

package() {
    cd "$pkgname-$pkgver" 2>/dev/null || cd "$srcdir/$pkgname" 2>/dev/null || true
    install -Dm755 target/release/dockd "$pkgdir/usr/bin/dockd"
    install -Dm644 systemd/user/dockd.service "$pkgdir/usr/lib/systemd/user/dockd.service"
    install -Dm644 systemd/user/dockd.socket "$pkgdir/usr/lib/systemd/user/dockd.socket"

    install -d -m0755 "$pkgdir/usr/share/omarchy/plugins/org.ubermetroid.dockd"
    cp -rf plugin/* "$pkgdir/usr/share/omarchy/plugins/org.ubermetroid.dockd/"
    install -Dm755 uninstall.sh "$pkgdir/usr/share/omarchy/plugins/org.ubermetroid.dockd/uninstall.sh"
    ln -sf /usr/share/omarchy/plugins/org.ubermetroid.dockd/uninstall.sh "$pkgdir/usr/bin/dockd-uninstall"


    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
